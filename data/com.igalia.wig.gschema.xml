<?xml version="1.0" encoding="UTF-8"?>
<schemalist>

  <enum id="com.igalia.wig.TabLayout">
    <value nick="horizontal" value="0"/>
    <value nick="vertical" value="1"/>
  </enum>

  <enum id="com.igalia.wig.UnloadUnusedTabs">
    <value nick="never" value="0"/>
    <value nick="15-minutes" value="15"/>
    <value nick="30-minutes" value="30"/>
    <value nick="1-hour" value="60"/>
    <value nick="6-hours" value="360"/>
  </enum>

  <enum id="com.igalia.wig.HTTPSNavigationPolicy">
    <value nick="keep-as-requested" value="0"/>
    <value nick="https-first" value="1"/>
    <value nick="https-only" value="2"/>
  </enum>

  <enum id="com.igalia.wig.CookieAcceptPolicy">
    <value nick="always" value="0"/>
    <value nick="never" value="1"/>
    <value nick="no-third-party" value="2"/>
  </enum>

  <enum id="com.igalia.wig.ProxyMode">
    <value nick="system" value="0"/>
    <value nick="none" value="1"/>
    <value nick="custom" value="2"/>
  </enum>

  <schema id="com.igalia.wig" path="/com/igalia/wig/">
    <key name="restore-tabs" type="b">
      <default>true</default>
      <summary>Restore Tabs on Startup</summary>
    </key>

    <key name="show-favorites" type="b">
      <default>true</default>
      <summary>Show Favorite Bookmarks</summary>
    </key>

    <key name="show-frequently-visited" type="b">
      <default>true</default>
      <summary>Show Frequently Visited Sites</summary>
    </key>

    <key name="show-recently-closed" type="b">
      <default>true</default>
      <summary>Show Recently Closed Tabs</summary>
    </key>

    <key name="tab-layout" enum="com.igalia.wig.TabLayout">
      <default>'horizontal'</default>
      <summary>Tab Layout</summary>
    </key>

    <key name="unload-unused-tabs" enum="com.igalia.wig.UnloadUnusedTabs">
      <default>'never'</default>
      <summary>Unload Unused Tabs</summary>
    </key>

    <key name="feature-overrides" type="a{sb}">
      <default>{}</default>
      <summary>Feature Overrides</summary>
    </key>

    <key name="https-navigation-policy" enum="com.igalia.wig.HTTPSNavigationPolicy">
      <default>'keep-as-requested'</default>
      <summary>HTTPS Navigation</summary>
    </key>

    <key name="cookie-accept-policy" enum="com.igalia.wig.CookieAcceptPolicy">
      <default>'no-third-party'</default>
      <summary>Accept Cookies</summary>
    </key>

    <key name="proxy-mode" enum="com.igalia.wig.ProxyMode">
      <default>'system'</default>
      <summary>Default Proxy</summary>
    </key>

    <key name="proxy-url" type="s">
      <default>''</default>
      <summary>Proxy URL</summary>
    </key>

    <key name="proxy-ignore-hosts" type="as">
      <default>[]</default>
      <summary>Sites That Bypass the Proxy</summary>
    </key>

    <key name="search-engine" type="s">
      <default>'https://duckduckgo.com/?q=%s'</default>
      <summary>Search Engine</summary>
    </key>

    <key name="javascript-can-open-windows-automatically" type="b">
      <default>false</default>
      <summary>Allow Pop-up Windows</summary>
    </key>

    <key name="auto-load-images" type="b">
      <default>true</default>
      <summary>Load Images</summary>
    </key>

    <key name="media-playback-requires-user-gesture" type="b">
      <default>false</default>
      <summary>Require a Click Before Media Plays</summary>
    </key>

    <key name="zoom-text-only" type="b">
      <default>false</default>
      <summary>Zoom Text Only</summary>
    </key>

    <key name="enable-javascript" type="b">
      <default>true</default>
      <summary>JavaScript</summary>
    </key>

    <key name="enable-webgl" type="b">
      <default>true</default>
      <summary>WebGL</summary>
    </key>

    <key name="enable-media" type="b">
      <default>true</default>
      <summary>Audio and Video</summary>
    </key>

    <key name="enable-encrypted-media" type="b">
      <default>true</default>
      <summary>Protected Content</summary>
    </key>

    <key name="enable-media-stream" type="b">
      <default>true</default>
      <summary>Camera and Microphone</summary>
    </key>

    <key name="enable-webrtc" type="b">
      <default>true</default>
      <summary>WebRTC</summary>
    </key>

    <key name="enable-html5-local-storage" type="b">
      <default>true</default>
      <summary>Local Storage</summary>
    </key>

    <key name="enable-html5-database" type="b">
      <default>true</default>
      <summary>Databases</summary>
    </key>

    <key name="enable-developer-extras" type="b">
      <default>true</default>
      <summary>Developer Tools</summary>
    </key>

    <key name="memory-limit" type="u">
      <default>0</default>
      <range min="0" max="1048576"/>
      <summary>Memory Limit</summary>
    </key>

    <key name="memory-conservative-threshold" type="d">
      <default>0</default>
      <range min="0" max="1"/>
      <summary>Conservative Threshold</summary>
    </key>

    <key name="memory-strict-threshold" type="d">
      <default>0</default>
      <range min="0" max="1"/>
      <summary>Strict Threshold</summary>
    </key>

    <key name="memory-kill-threshold" type="d">
      <default>0</default>
      <range min="0" max="1"/>
      <summary>Kill Threshold</summary>
    </key>

    <key name="memory-poll-interval" type="d">
      <default>0</default>
      <range min="0" max="600"/>
      <summary>Poll Interval</summary>
    </key>

    <key name="user-agent" type="s">
      <default>''</default>
      <summary>User Agent</summary>
    </key>
  </schema>

</schemalist>
